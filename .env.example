# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
VERIFIER_MODEL=gpt-4o
LLM_API_KEY=your_llm_api_key_here

# Search / Retrieval
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=your_search_api_key_here

# Database
DATABASE_URL=postgresql+asyncpg://hallu:hallu@localhost:5432/hallu_guard

# Redis
REDIS_URL=redis://localhost:6379/0

# Verification Behavior
MAX_RETRIES=3
VERIFICATION_MODE=standard
CONFIDENCE_THRESHOLD=0.7
SOURCE_FRESHNESS_LIMIT_DAYS=90
MIN_EVIDENCE_SOURCES=1

# Feature Flags
ENABLE_CODE_EXECUTION=false
ENABLE_WEB_VERIFICATION=true
ENABLE_CACHING=true
ENABLE_ADVERSARIAL_PASS=false

# Security
API_SECRET_KEY=change_me_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Observability
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
ENABLE_DEBUG_MODE=false
